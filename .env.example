# Copia questo file in ".env" (facoltativo) e personalizza i valori.

# Porta su cui ascolta il server Flask-SocketIO
PORT=5000

# Host di binding (0.0.0.0 per accettare connessioni da qualsiasi interfaccia)
HOST=0.0.0.0

# Chiave segreta usata da Flask per firmare la sessione dei cookie interni.
# In produzione impostane una lunga e casuale, ad esempio con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-questa-chiave-in-produzione

# Modalita' debug di Flask/SocketIO (true/false). Tenerla su false in produzione.
DEBUG=false
